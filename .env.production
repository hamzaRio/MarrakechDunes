# --- Environment ---
NODE_ENV=production

# --- Database ---
DATABASE_URL=your-mongodb-atlas-uri-here

# --- Security ---
SESSION_SECRET=your-production-session-secret-here
JWT_SECRET=your-production-jwt-secret-here

# --- CORS ---
CLIENT_URL=https://marrakech-dunes.vercel.app,https://marrakech-dunes-*.vercel.app,http://localhost:5173

# --- Admin Credentials ---
ADMIN_PASSWORD=your-admin-password-here
SUPERADMIN_PASSWORD=your-superadmin-password-here

