# === Server Environment Production Example ===
NODE_ENV=production
PORT=10000

DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/marrakech-dunes?retryWrites=true&w=majority

JWT_SECRET=${JWT_SECRET_PROD}
SESSION_SECRET=${SESSION_SECRET_PROD}

ADMIN_PASSWORD=${ADMIN_PASSWORD_PROD}
SUPERADMIN_PASSWORD=${SUPERADMIN_PASSWORD_PROD}

CLIENT_URL=https://marrakech-dunes.vercel.app,https://*.vercel.app

WHATSAPP_RECEIVERS=+212600000000,+212700000000
MAP_PROVIDER=iframe

