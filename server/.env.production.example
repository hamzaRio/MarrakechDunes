# === Server Production Configuration ===
NODE_ENV=production
PORT=10000
ROLE=all

# === Database ===
DATABASE_URL=<your-mongodb-connection-string>

# === Security ===
SESSION_SECRET=your_strong_session_secret_here
JWT_SECRET=your_strong_jwt_secret_here
CSRF_TOKEN_SECRET=your-csrf-secret-key-here

# === Admin Credentials ===
ADMIN_PASSWORD=your-admin-password-here
SUPERADMIN_PASSWORD=your-superadmin-password-here

# === CORS / Client URLs ===
CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
VITE_API_URL=https://api.example.com/api
VITE_ASSETS_BASE=https://api.example.com/assets

# === WhatsApp Integration ===
WHATSAPP_RECEIVERS=<owned-phone-number>,<owned-phone-number>,<owned-phone-number>

# === Map Configuration ===
MAP_PROVIDER=iframe
LEAFLET_ENABLED=false

# === GetYourGuide Official Partner API (server-side only) ===
GYG_PARTNER_API_BASE=https://api.getyourguide.com/1
GYG_PARTNER_API_TOKEN=<your-getyourguide-partner-api-token>
GYG_PARTNER_API_LANGUAGE=en
GYG_PARTNER_API_CURRENCY=MAD
# Legacy Supplier API settings (only for legacy supplier-side integrations)
GYG_SUPPLIER_BASE=https://supplier-api.getyourguide.com/1
GYG_SUPPLIER_USER=<your-gyg-supplier-user>
GYG_SUPPLIER_PASS=<your-gyg-supplier-password>
GYG_ENABLE_LIVE_SEARCH=true

# Viator Partner API (server-side only)
VIATOR_API_KEY=<your-viator-partner-api-key>
VIATOR_API_BASE=https://api.viator.com/partner
VIATOR_API_LANGUAGE=en-US
VIATOR_API_CURRENCY=EUR
VIATOR_MARKET_INTELLIGENCE_ENABLED=false
BAM_API_KEY=<your-bam-subscription-key>
BAM_API_BASE=https://api.centralbankofmorocco.ma/cours/Version1

# === Object Storage (provider-selected; uploads are optional) ===
# OBJECT_STORAGE_PROVIDER=replit-sidecar
# OBJECT_STORAGE_SIDECAR_ENDPOINT=http://127.0.0.1:1106
# PRIVATE_OBJECT_DIR=<private-object-directory>

# === Locale & Encoding ===
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
FORCE_COLOR=true
