# MarrakechDunes Server Environment Variables
# Copy this file to .env and fill in your values

# Core Environment
NODE_ENV=production
PORT=10000
ROLE=all

# Database
DATABASE_URL=<your-mongodb-connection-string>

# Security
SESSION_SECRET=your-super-secret-session-key-here
JWT_SECRET=your-jwt-secret-key-here
CSRF_TOKEN_SECRET=your-csrf-secret-key-here

# Admin Credentials
ADMIN_PASSWORD=your-admin-password-here
SUPERADMIN_PASSWORD=your-superadmin-password-here

# WhatsApp Integration
WHATSAPP_RECEIVERS=your-whatsapp-numbers-comma-separated

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-app-password
SMTP_FROM=MarrakechDunes <noreply@marrakechdunes.com>

# GetYourGuide Official Partner API (server-side only)
GYG_PARTNER_API_BASE=https://api.getyourguide.com/1
GYG_PARTNER_API_TOKEN=<your-getyourguide-partner-api-token>
GYG_PARTNER_API_LANGUAGE=en
GYG_PARTNER_API_CURRENCY=MAD
# Legacy Supplier API settings (only for legacy supplier-side integrations)
GYG_SUPPLIER_BASE=https://supplier-api.getyourguide.com/1
GYG_SUPPLIER_USER=<your-gyg-supplier-user>
GYG_SUPPLIER_PASS=<your-gyg-supplier-password>
GYG_ENABLE_LIVE_SEARCH=true

# Viator Partner API (server-side only)
VIATOR_API_KEY=<your-viator-partner-api-key>
VIATOR_API_BASE=https://api.viator.com/partner
VIATOR_API_LANGUAGE=en-US
VIATOR_API_CURRENCY=EUR
VIATOR_MARKET_INTELLIGENCE_ENABLED=false
BAM_API_KEY=<your-bam-subscription-key>
BAM_API_BASE=https://api.centralbankofmorocco.ma/cours/Version1

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Locale Configuration
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# Backend Only
FORCE_COLOR=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-app-password
SMTP_FROM="MarrakechDunes <noreply@marrakechdunes.com>"

# ===========================================
# EMAIL CONFIGURATION (LEGACY - Gmail specific)
# ===========================================
# EMAIL_USER=user@example.com
# EMAIL_PASS=your-gmail-app-password-here
# EMAIL_FROM="Marrakech Dunes <user@example.com>"
# ===========================================
# ADMIN NOTIFICATIONS
# ===========================================
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Comma-separated list of admin email addresses for notifications
# EMAIL CONFIGURATION (SMTP - CANONICAL)
# Object storage is provider-selected; the sidecar adapter is retained for
# existing installations. Set PRIVATE_OBJECT_DIR when uploads are enabled.
# OBJECT_STORAGE_PROVIDER=replit-sidecar
# OBJECT_STORAGE_SIDECAR_ENDPOINT=http://127.0.0.1:1106
# PRIVATE_OBJECT_DIR=<private-object-directory>
