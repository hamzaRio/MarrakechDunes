### Server Example Environment ###
NODE_ENV=production
PORT=10000

# Database (MongoDB Atlas recommended for production)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/marrakechdunes?retryWrites=true&w=majority

# Security
SESSION_SECRET=your_strong_session_secret_here
JWT_SECRET=your_strong_jwt_secret_here

# Admin Credentials
ADMIN_PASSWORD=secure_admin_password
SUPERADMIN_PASSWORD=secure_superadmin_password

# Frontend / CORS (Multiple allowed origins separated by commas)
CLIENT_URL=https://marrakech-dunes.vercel.app,https://*.vercel.app,http://localhost:5173
VITE_API_URL=https://marrakechdunes.onrender.com/api
VITE_ASSETS_BASE=https://marrakechdunes.onrender.com/assets

# Integrations
WHATSAPP_RECEIVERS=+212600623630,+212693323368,+212654497354
MAP_PROVIDER=iframe

# GetYourGuide Live Search Integration
GYG_API_BASE=https://api.getyourguide.com/1
GYG_API_KEY=your_real_getyourguide_partner_api_key
GYG_ENABLE_LIVE_SEARCH=true
GYG_UNDERCUT_PERCENT=0.1
GYG_MARGIN_FIXED=0
GYG_MIN_PRICE=15

  GYG_SUPPLIER_BASE=https://supplier-api.getyourguide.com/sandbox/1
  GYG_SUPPLIER_USER=your_supplier_username
  GYG_SUPPLIER_PASS=your_supplier_password

# Encoding & Locale
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
FORCE_COLOR=true
