# MarrakechDunes Server Environment Variables
# Copy this file to .env and fill in your values

# Core Environment
NODE_ENV=production
PORT=10000

# Database
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/marrakech-tours

# Security
SESSION_SECRET=your-super-secret-session-key-here
JWT_SECRET=your-jwt-secret-key-here
CSRF_TOKEN_SECRET=your-csrf-secret-key-here

# Admin Credentials
ADMIN_PASSWORD=admin123
SUPERADMIN_PASSWORD=superadmin123

# WhatsApp Integration
WHATSAPP_RECEIVERS=212600623630,212693323368,212654497354

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MarrakechDunes <noreply@marrakechdunes.com>

# GetYourGuide Live Search (Partner API)
GYG_SUPPLIER_BASE=https://partner-api.getyourguide.com/1
GYG_SUPPLIER_USER=MarrakechDunes
GYG_SUPPLIER_PASS=4070f0b0f1e14321ce4634ac4ab00806
GYG_ENABLE_LIVE_SEARCH=true

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Locale Configuration
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# Backend Only
FORCE_COLOR=1
