# MarrakechDunes Server Environment Variables
# Copy this file to .env and fill in your values

# Core Environment
NODE_ENV=production
PORT=10000

# Database
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/marrakech-tours

# Security
SESSION_SECRET=your-super-secret-session-key-here
JWT_SECRET=your-jwt-secret-key-here
CSRF_TOKEN_SECRET=your-csrf-secret-key-here

# Admin Credentials
ADMIN_PASSWORD=your-admin-password-here
SUPERADMIN_PASSWORD=your-superadmin-password-here

# WhatsApp Integration
WHATSAPP_RECEIVERS=your-whatsapp-numbers-comma-separated

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MarrakechDunes <noreply@marrakechdunes.com>

# GetYourGuide Live Search (Partner API)
GYG_SUPPLIER_BASE=https://supplier-api.getyourguide.com/1
GYG_SUPPLIER_USER=MarrakechDunes
GYG_SUPPLIER_PASS=your-gyg-supplier-password-here
GYG_ENABLE_LIVE_SEARCH=true

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Locale Configuration
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# Backend Only
FORCE_COLOR=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="MarrakechDunes <noreply@marrakechdunes.com>"

# ===========================================
# EMAIL CONFIGURATION (LEGACY - Gmail specific)
# ===========================================
# EMAIL_USER=timedizzy45@gmail.com
# EMAIL_PASS=your-gmail-app-password-here
# EMAIL_FROM="Marrakech Dunes <timedizzy45@gmail.com>"
# ===========================================
# ADMIN NOTIFICATIONS
# ===========================================
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Comma-separated list of admin email addresses for notifications
# EMAIL CONFIGURATION (SMTP - CANONICAL)