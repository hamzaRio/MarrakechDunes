{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://marrakechdunes.onrender.com/api/$1" },
    { "source": "/attached_assets/(.*)", "destination": "https://marrakechdunes.onrender.com/attached_assets/$1" }
  ],
  "headers": [
    {
      "source": "/attached_assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
