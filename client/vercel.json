{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/"
    },
    {
      "source": "/activities",
      "destination": "/"
    },
    {
      "source": "/booking",
      "destination": "/"
    },
    {
      "source": "/reviews",
      "destination": "/"
    },
    {
