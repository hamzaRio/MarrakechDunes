{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://marrakechdunes.onrender.com/api/:path*" },
    { "source": "/assets/:path*", "destination": "https://marrakechdunes.onrender.com/assets/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
