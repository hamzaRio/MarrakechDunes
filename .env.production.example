SESSION_SECRET=your_production_session_secret_key_here
WHATSAPP_RECEIVERS=+1234567890,+0987654321
ADMIN_PASSWORD=secure_admin_password
SUPERADMIN_PASSWORD=secure_superadmin_password
MAP_PROVIDER=iframe

