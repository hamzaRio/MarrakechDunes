# === Production Environment Variables (Template) ===

# Database (Atlas URI - replace <username>, <password>, <cluster>)
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marrakech-tours?retryWrites=true&w=majority

# Security Secrets (use at least 32-char random strings in production)
SESSION_SECRET=__REPLACE_WITH_LONG_RANDOM_STRING__
JWT_SECRET=__REPLACE_WITH_LONG_RANDOM_STRING__

# Application URLs
CLIENT_URL=https://marrakech-dunes.vercel.app

# Admin Credentials
ADMIN_PASSWORD=__ADMIN_PASSWORD__   # e.g., Marrakech@2025
SUPERADMIN_PASSWORD=__SUPERADMIN_PASSWORD__   # e.g., Marrakech@1966

# WhatsApp Integration
WHATSAPP_RECEIVERS=212600623630,212693323368,212654497354

# Environment
NODE_ENV=production
PORT=10000   # Render defaults to 10000

# Optional: Object Storage (for file uploads)
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# Optional: CDN Configuration
CDN_URL=
