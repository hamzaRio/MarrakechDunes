# Root Environment Variables Production Example
NODE_ENV=production
VITE_API_URL=https://marrakechdunes.onrender.com
VITE_ASSETS_BASE=https://marrakechdunes.onrender.com/assets
CLIENT_URL=https://marrakech-dunes.vercel.app,https://*.vercel.app
