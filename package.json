{
  "name": "marrakechdunes-monorepo",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "start:server": "powershell -NoProfile -ExecutionPolicy Bypass -Command \". .\\\\scripts\\\\load-env.ps1; node server/dist/index.js\"",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:NODE_ENV='production'; cd server; npm run start:build\"",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:server": "tsx server/src/index.ts",
    "dev:client": "vite",
    "dev:frontend": "npm run dev:client",
    "dev:backend": "npm run dev:server",
    "build:frontend": "npm run build -w client",
    "build:backend": "npm run build -w server",
    "test": "npm run test -w client",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts\\\\e2e.ps1",
    "check": "tsc",
    "health:backend": "powershell -NoProfile -ExecutionPolicy Bypass -Command \". .\\\\scripts\\\\load-env.ps1 -Silent; curl -fsS http://localhost:10000/api/health\" || exit 1",
    "health:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -Command \". .\\\\scripts\\\\load-env.ps1 -Silent; curl -fsS http://localhost:5173\" || exit 1",
    "login:test:nadia": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\\\login-nadia.ps1",
    "build:shared": "npm --prefix shared run build"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
