# MarrakechDunes Environment Variables - Comprehensive Example
# Copy this file to .env and fill in your values

# ===========================================
# BASIC CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=10000

# ===========================================
# FRONTEND CONFIGURATION (Vercel)
# ===========================================
CLIENT_URL=http://localhost:5173,https://marrakech-dunes.vercel.app
VITE_API_URL=https://marrakechdunes-sppy.onrender.com
VITE_ASSETS_BASE=https://marrakechdunes-sppy.onrender.com/assets
VITE_MAP_PROVIDER=iframe
VITE_LEAFLET_ENABLED=false

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=mongodb://localhost:27017/marrakechdunes
# For production: mongodb+srv://username:password@cluster.mongodb.net/marrakechdunes

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=your-super-secret-session-key-here-min-32-chars
ADMIN_PASSWORD=your-admin-password
SUPERADMIN_PASSWORD=your-superadmin-password

# ===========================================
# EMAIL CONFIGURATION (SMTP - CANONICAL)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="MarrakechDunes <noreply@marrakechdunes.com>"

# Optional fallback provider (Resend). Configure if you prefer using the Resend API
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM="MarrakechDunes <notifications@your-domain.com>"

# ===========================================
# EMAIL CONFIGURATION (LEGACY - Gmail specific)
# ===========================================
# EMAIL_USER=timedizzy45@gmail.com
# EMAIL_PASS=your-gmail-app-password-here
# EMAIL_FROM="Marrakech Dunes <timedizzy45@gmail.com>"

# To get Gmail App Password:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account Settings > Security > 2-Step Verification
# 3. Generate App Password for "Mail"
# 4. Use the 16-character password (no spaces) as SMTP_PASS

# ===========================================
# ADMIN NOTIFICATIONS
# ===========================================
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Comma-separated list of admin email addresses for notifications

# ===========================================
# EXTERNAL API KEYS (OPTIONAL)
# ===========================================
# GetYourGuide API (for competitor search)
GYG_API_KEY=your-getyourguide-api-key
GYG_API_SECRET=your-getyourguide-api-secret

# GetYourGuide Supplier API
GYG_SUPPLIER_BASE=https://supplier-api.getyourguide.com/1
GYG_SUPPLIER_USER=MarrakechDunes
GYG_SUPPLIER_PASS=your-gyg-supplier-password
GYG_ENABLE_LIVE_SEARCH=true

# Viator API (alternative competitor source)
VIATOR_API_KEY=your-viator-api-key

# ===========================================
# WHATSAPP INTEGRATION
# ===========================================
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
ADMIN_WHATSAPP_NUMBER=+212xxxxxxxxx

# ===========================================
# TWILIO SMS & WHATSAPP (OPTIONAL BUT RECOMMENDED)
# ===========================================
# Get your credentials from https://console.twilio.com/
# Free trial includes $15 credit for testing
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
# Twilio WhatsApp Sandbox number (for testing)
# For production: Use your approved WhatsApp Business number
TWILIO_WHATSAPP_NUMBER=+14155238886
# Note: If Twilio is not configured, OTP will work in dev mode (OTP shown in console)
# WhatsApp reminders will fallback to manual WhatsApp links

# ===========================================
# REDIS CACHING (OPTIONAL)
# ===========================================
REDIS_URL=redis://localhost:6379
# For production: redis://username:password@host:port

# ===========================================
# MONITORING & LOGGING
# ===========================================
SENTRY_DSN=your-sentry-dsn-for-error-tracking
DEBUG=false
LOG_LEVEL=info

# ===========================================
# FILE STORAGE (OPTIONAL)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# ===========================================
# LOCALE CONFIGURATION
# ===========================================
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# These are only used in development
# In production, use your actual values
