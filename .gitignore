# === Dependencies ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Build outputs ===
dist/
build/
client/dist/
server/dist/
*.tsbuildinfo

# === Environment files ===
# Ignore all real env files
.env
.env.local
.env.development
.env.test
.env.staging
.env.production

# Keep only safe examples under Git
!/.env.example
!/.env.production.example
!/server/.env.example
!/server/.env.production.example
!/client/.env.example
!/client/.env.production.example

# === IDE configs ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Local development ===
.local/
.replit/
agent_state

# === OS files ===
.DS_Store
Thumbs.db

# === Logs ===
logs/
*.log

# === Runtime data ===
pids/
*.pid
*.seed
*.pid.lock

# === Coverage ===
coverage/
*.lcov

# === Testing ===
test-results/
playwright-report/
test-*.js
test-*.ts
tests/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# === Cache ===
.npm/
.eslintcache
.cache/
.parcel-cache

# === Temp ===
tmp/
temp/

# === Database dumps ===
*.db
*.sqlite

# === Uploads (but keep attached_assets for project) ===
uploads/
!attached_assets/

# === Archives ===
*.zip
*.rar
*.7z
*.bak
*.backup

# === Docker ===
.dockerignore

# === Hosting configs (keep only Render + Vercel) ===
.vercel

