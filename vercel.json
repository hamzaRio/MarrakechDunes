{
  "version": 2,
  "builds": [
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://marrakechdunes.onrender.com/api/:path*" },
    { "source": "/attached_assets/:path*", "destination": "https://marrakechdunes.onrender.com/attached_assets/:path*" },
    { "source": "/(?!api|_next|_static|favicon.ico|attached_assets|assets|.*\\..*)", "destination": "/" }
  ],
  "env": {
    "NODE_VERSION": "20",
    "VITE_API_URL": "/api",
    "VITE_ASSETS_BASE": "/attached_assets"
  }
}