{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/" }
  ],
  "env": {
    "NODE_VERSION": "20",
    "VITE_API_URL": "https://marrakechdunes.onrender.com",
    "VITE_ASSETS_BASE": "https://marrakechdunes.onrender.com/assets"
  }
}