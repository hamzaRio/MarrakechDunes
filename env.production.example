# === MarrakechDunes Production Environment Configuration ===
# Copy this file to .env.production and fill in your actual production values

# === Database Configuration ===
# MongoDB Atlas connection string (required for production)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/marrakechdunes

# === Authentication & Security ===
# Session secret (minimum 32 characters in production)
SESSION_SECRET=your-super-secure-production-session-secret-minimum-32-characters-long

# JWT secret for token generation
JWT_SECRET=your-production-jwt-secret-key

# Admin credentials (will be hashed with bcrypt)
ADMIN_PASSWORD=Marrakech@2025
SUPERADMIN_PASSWORD=Marrakech@1966

# === Application Configuration ===
# Port for the server (Render uses 10000)
PORT=10000

# Client URL for CORS (production domains)
CLIENT_URL=https://marrakech-dunes.vercel.app,https://*.vercel.app

# === Frontend Configuration ===
# API URL for frontend (production backend URL)
VITE_API_URL=https://marrakechdunes.onrender.com

# Assets base URL (production backend assets)
VITE_ASSETS_BASE=https://marrakechdunes.onrender.com/attached_assets

# === WhatsApp Integration ===
# Comma-separated list of phone numbers to receive notifications
WHATSAPP_RECEIVERS=212600623630,212693323368,212654497354

# === Production Configuration ===
# Node environment
NODE_ENV=production

# === Security Notes ===
# 1. Use strong, unique passwords for ADMIN_PASSWORD and SUPERADMIN_PASSWORD
# 2. Use a secure MongoDB Atlas connection string
# 3. Generate a strong SESSION_SECRET (32+ characters)
# 4. Never commit this file with real credentials
# 5. Set these values in your deployment platform (Render/Vercel)
