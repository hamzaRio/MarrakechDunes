# MarrakechDunes Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=mongodb://localhost:27017/marrakechdunes
# For production: mongodb+srv://username:password@cluster.mongodb.net/marrakechdunes

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=your-super-secret-session-key-here-min-32-chars
ADMIN_PASSWORD=your-admin-password
SUPERADMIN_PASSWORD=your-superadmin-password

# ===========================================
# EMAIL CONFIGURATION (SMTP - CANONICAL)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="MarrakechDunes <noreply@marrakechdunes.com>"

# ===========================================
# EMAIL CONFIGURATION (LEGACY - Gmail specific)
# ===========================================
# EMAIL_USER=timedizzy45@gmail.com
# EMAIL_PASS=your-gmail-app-password-here
# EMAIL_FROM="Marrakech Dunes <timedizzy45@gmail.com>"

# To get Gmail App Password:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account Settings > Security > 2-Step Verification
# 3. Generate App Password for "Mail"
# 4. Use the 16-character password (no spaces) as SMTP_PASS

# ===========================================
# CORS & CLIENT CONFIGURATION
# ===========================================
CLIENT_URL=http://localhost:5173,https://marrakech-dunes.vercel.app
# For production: https://marrakech-dunes.vercel.app,https://marrakech-dunes-*.vercel.app

# ===========================================
# ADMIN NOTIFICATIONS
# ===========================================
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Comma-separated list of admin email addresses for notifications

# ===========================================
# EXTERNAL API KEYS (OPTIONAL)
# ===========================================
# GetYourGuide API (for competitor search)
GYG_API_KEY=your-getyourguide-api-key
GYG_API_SECRET=your-getyourguide-api-secret

# Viator API (alternative competitor source)
VIATOR_API_KEY=your-viator-api-key

# ===========================================
# WHATSAPP INTEGRATION
# ===========================================
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
ADMIN_WHATSAPP_NUMBER=+212xxxxxxxxx

# ===========================================
# REDIS CACHING (OPTIONAL)
# ===========================================
REDIS_URL=redis://localhost:6379
# For production: redis://username:password@host:port

# ===========================================
# MONITORING & LOGGING
# ===========================================
SENTRY_DSN=your-sentry-dsn-for-error-tracking
NODE_ENV=development
# For production: NODE_ENV=production

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=8080
# For production: PORT=10000 (Render default)

# ===========================================
# FILE STORAGE (OPTIONAL)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# These are only used in development
# In production, use your actual values
DEBUG=false
LOG_LEVEL=info