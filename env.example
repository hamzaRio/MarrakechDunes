# MarrakechDunes Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/marrakech-tours

# Security
SESSION_SECRET=your-super-secret-session-key-here
JWT_SECRET=your-jwt-secret-key-here
CSRF_TOKEN_SECRET=your-csrf-secret-key-here

# Admin Credentials
ADMIN_PASSWORD=admin123
SUPERADMIN_PASSWORD=superadmin123

# URLs
CLIENT_URL=http://localhost:5173,https://marrakech-dunes.vercel.app
PORT=10000

# WhatsApp Integration
WHATSAPP_RECEIVERS=212600623630,212693323368,212654497354

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MarrakechDunes <noreply@marrakechdunes.com>

# Monitoring & Analytics
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PWA & Push Notifications
VITE_PUSH_PUBLIC_KEY=your-vapid-public-key
VITE_PUSH_VAPID_SUBJECT=mailto:your-email@example.com

# Customer Portal
OTP_WINDOW_MINUTES=10

# Maps
MAP_PROVIDER=iframe
LEAFLET_ENABLED=false

# API Keys (if needed)
# VITE_API_URL=http://localhost:10000/api
GYG_API_KEY=your_getyourguide_api_key

# GetYourGuide Competitive Pricing Configuration
GYG_UNDERCUT_PERCENT=0.1
GYG_MARGIN_FIXED=0
GYG_MIN_PRICE=15

# WhatsApp Configuration
WHATSAPP_RECEIVERS=+212123456789,+212987654321

# Admin Email Configuration
ADMIN_EMAILS=admin@marrakechdunes.com,manager@marrakechdunes.com

# SMTP Configuration for Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MarrakechDunes <noreply@marrakechdunes.com>
