FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY client/package*.json client/
COPY server/package*.json server/
COPY shared/package*.json shared/
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY server server
COPY shared shared
RUN npm run build:shared && npm run build:server

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
ENV PORT=10000
WORKDIR /app
COPY package*.json ./
COPY client/package*.json client/
COPY server/package*.json server/
COPY shared/package*.json shared/
RUN npm ci --omit=dev --legacy-peer-deps --no-audit --no-fund && npm cache clean --force
COPY --from=build --chown=node:node /app/server/dist server/dist
COPY --from=build --chown=node:node /app/shared/dist shared/dist
USER node
WORKDIR /app/server
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "require('http').get('http://127.0.0.1:' + (process.env.PORT || 10000) + '/api/health/ready', r => { process.exit(r.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"
CMD ["node", "dist/index.js"]
