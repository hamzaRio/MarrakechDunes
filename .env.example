# ===============================
# MarrakechDunes Environment Vars
# ===============================

# === Frontend URLs (CORS + Sessions) ===
# Multiple domains allowed (comma separated)
CLIENT_URL=https://marrakech-dunes.vercel.app,https://*.vercel.app,http://localhost:5173

# === Backend API (Render URL) ===
VITE_API_URL=https://marrakechdunes.onrender.com

# === Static Assets Path (Render) ===
VITE_ASSETS_BASE=https://marrakechdunes.onrender.com/assets
