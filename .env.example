# === Database Configuration ===
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/database-name
# Alias for frameworks expecting DATABASE_URL
DATABASE_URL=${MONGODB_URI}

# === Authentication & Security ===
JWT_SECRET=your-jwt-secret
SESSION_SECRET=your-session-secret

# === Admin User Credentials (initial setup) ===
ADMIN_PASSWORD=your-admin-password
SUPERADMIN_PASSWORD=your-superadmin-password

# === WhatsApp Integration ===
WHATSAPP_RECEIVERS=212600623630,212693323368,212654497354

# === CORS (comma-separated origins) ===
CLIENT_URL=http://localhost:5173

# === Server Configuration ===
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000
VITE_ASSETS_BASE=http://localhost:5000/assets

# === Optional: External Service APIs ===
# SENDGRID_API_KEY=your-sendgrid-api-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
