# === Environment ===
NODE_ENV=development
PORT=10000

# === Frontend (Vercel) ===
CLIENT_URL=http://localhost:5173,https://marrakech-dunes.vercel.app
VITE_API_URL=https://marrakechdunes-spyy.onrender.com/api
VITE_ASSETS_BASE=https://marrakechdunes-spyy.onrender.com/assets
VITE_MAP_PROVIDER=iframe
VITE_LEAFLET_ENABLED=false

# === Integrations ===
# Official Partner API (server-side only; request access from GetYourGuide)
GYG_PARTNER_API_BASE=https://api.getyourguide.com/1
GYG_PARTNER_API_TOKEN=<your-getyourguide-partner-api-token>
GYG_PARTNER_API_LANGUAGE=en
GYG_PARTNER_API_CURRENCY=MAD
# Legacy Supplier API settings (only for legacy supplier-side integrations)
GYG_SUPPLIER_BASE=https://supplier-api.getyourguide.com/1
GYG_SUPPLIER_USER=<your-gyg-supplier-user>
GYG_SUPPLIER_PASS=<your-gyg-supplier-password>
GYG_ENABLE_LIVE_SEARCH=true

# === Locale ===
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=timedizzy45@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MarrakechDunes <timedizzy45@gmail.com>
