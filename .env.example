# === MarrakechDunes Environment Configuration ===
# Copy this file to .env and fill in your actual values

# === Database Configuration ===
# MongoDB connection string (required)
DATABASE_URL=mongodb://localhost:27017/marrakechdunes
# For production: mongodb+srv://username:password@cluster.mongodb.net/marrakechdunes

# === Authentication & Security ===
# Session secret (minimum 32 characters in production)
SESSION_SECRET=your-super-secret-session-key-minimum-32-chars

# JWT secret for token generation
JWT_SECRET=your-jwt-secret-key

# Admin credentials (will be hashed with bcrypt)
ADMIN_PASSWORD=your-secure-admin-password
SUPERADMIN_PASSWORD=your-secure-superadmin-password

# === Application Configuration ===
# Port for the server (default: 10000)
PORT=10000

# Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://marrakech-dunes.vercel.app

# === Frontend Configuration ===
# API URL for frontend (should point to your backend)
VITE_API_URL=http://localhost:10000

# Assets base URL (for development)
VITE_ASSETS_BASE=http://localhost:10000/attached_assets

# === WhatsApp Integration ===
# Comma-separated list of phone numbers to receive notifications
WHATSAPP_RECEIVERS=212600623630,212693323368,212654497354

# === Optional Configuration ===
# Node environment
NODE_ENV=development

# === Production Notes ===
# In production:
# 1. Use strong, unique passwords for ADMIN_PASSWORD and SUPERADMIN_PASSWORD
# 2. Use a secure MongoDB Atlas connection string
# 3. Generate a strong SESSION_SECRET (32+ characters)
# 4. Set NODE_ENV=production
# 5. Update CLIENT_URL to include your production domain
# 6. Set VITE_API_URL to your production backend URL
