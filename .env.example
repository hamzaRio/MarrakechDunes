# Canonical configuration template. Copy to an ignored .env for local use.
# Deployment platforms provide these values as environment variables.
# REQUIRED in production: use deployment-owned values; never commit real secrets.
NODE_ENV=production
PORT=10000
# Runtime role: all (legacy), api, or worker
ROLE=all
DATABASE_URL=<mongodb-connection-string>
SESSION_SECRET=<random-secret-at-least-32-characters>
JWT_SECRET=<legacy-required-secret>
ADMIN_PASSWORD=<strong-admin-bootstrap-password>
SUPERADMIN_PASSWORD=<strong-superadmin-bootstrap-password>

# MIGRATION DEFAULT: true preserves existing owner startup seeding behavior.
# New installations set false, run npm run bootstrap once, then start API.
LEGACY_STARTUP_SEEDING=true
# BOOTSTRAP_ADMIN_USERNAME=<new-owner-username>
# BOOTSTRAP_ADMIN_PASSWORD=<new-owner-password-at-least-12-characters>
# SEED_DEMO_DATA=false

# REQUIRED for browser access: exact public/admin origins, comma separated.
# Set VITE_API_URL separately for both public and admin frontend builds.
CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
# OPTIONAL: only a narrow, deployment-owned preview pattern if needed.
# CORS_ALLOWED_ORIGIN_PATTERNS=https://web-*-team.example.com
VITE_API_URL=https://api.example.com/api

# OPTIONAL: defaults preserve today's production cookie/proxy behavior.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=
# TRUST_PROXY=1

# OPTIONAL: SMTP. Without configured credentials, email delivery is unavailable.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=notifications@example.com
# Legacy aliases still supported: EMAIL_USER, EMAIL_PASS, EMAIL_FROM, EMAIL_PORT.

# OPTIONAL: provider discovery; missing credentials degrade provider features.
VIATOR_API_KEY=<viator-api-key>
VIATOR_API_BASE=https://api.viator.com/partner
VIATOR_API_LANGUAGE=en-US
VIATOR_API_CURRENCY=EUR
VIATOR_MARKET_INTELLIGENCE_ENABLED=false
GYG_PARTNER_API_TOKEN=<getyourguide-partner-token>
GYG_PARTNER_API_BASE=https://api.getyourguide.com/1
GYG_PARTNER_API_LANGUAGE=en
GYG_PARTNER_API_CURRENCY=MAD
GYG_SUPPLIER_USER=<legacy-gyg-supplier-user>
GYG_SUPPLIER_PASS=<legacy-gyg-supplier-password>
GYG_SUPPLIER_BASE=https://supplier-api.getyourguide.com/1
GYG_ENABLE_LIVE_SEARCH=false
BAM_API_KEY=<bam-api-key>
BAM_API_BASE=https://api.centralbankofmorocco.ma/cours/Version1

# OPTIONAL: monitoring, notifications, and storage configuration.
# SENTRY_DSN=<sentry-dsn>
# VITE_SENTRY_DSN=<public-browser-sentry-dsn>
# WHATSAPP_RECEIVERS=<comma-separated-owned-recipients>
# PRIVATE_OBJECT_DIR=<private-object-directory>
# OBJECT_STORAGE_PROVIDER=replit-sidecar
# OBJECT_STORAGE_SIDECAR_ENDPOINT=http://127.0.0.1:1106
# OBJECT_STORAGE_S3_ENDPOINT=<optional-s3-compatible-endpoint>
# OBJECT_STORAGE_S3_REGION=<region-or-auto>
# OBJECT_STORAGE_S3_BUCKET=<bucket-name>
# OBJECT_STORAGE_S3_ACCESS_KEY_ID=<access-key-id>
# OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=<secret-access-key>
# OBJECT_STORAGE_S3_FORCE_PATH_STYLE=false
# OBJECT_STORAGE_S3_UPLOAD_EXPIRES_SECONDS=900
# OBJECT_STORAGE_S3_PUBLIC_BASE_URL=<required-stable-public-base-url-for-s3>

# COMPATIBILITY: CLIENT_URL remains accepted for the current deployment when
# CORS_ALLOWED_ORIGINS is absent. Do not use a wildcard origin with credentials.
# CLIENT_URL=https://www.example.com
