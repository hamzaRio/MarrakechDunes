FROM node:24-alpine AS build
ARG APP=public
WORKDIR /app
COPY package*.json ./
COPY client/package*.json client/
COPY server/package*.json server/
COPY shared/package*.json shared/
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY client client
COPY shared shared
COPY scripts scripts
RUN case "$APP" in public|admin) npm run build:${APP} ;; *) echo "APP must be public or admin" >&2; exit 1 ;; esac
RUN if [ "$APP" = "admin" ]; then cp -R client/dist-admin /app/web-dist; else cp -R client/dist /app/web-dist; fi

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
ARG APP=public
COPY docker/nginx-public.conf /tmp/nginx-public.conf
COPY docker/nginx-admin.conf /tmp/nginx-admin.conf
COPY docker/security-headers.conf /tmp/security-headers.conf
COPY docker/admin-robots.conf /tmp/admin-robots.conf
RUN if [ "$APP" = "admin" ]; then cp /tmp/nginx-admin.conf /etc/nginx/conf.d/default.conf; else cp /tmp/nginx-public.conf /etc/nginx/conf.d/default.conf; fi
RUN cp /tmp/security-headers.conf /etc/nginx/security-headers.conf && cp /tmp/admin-robots.conf /etc/nginx/admin-robots.conf
COPY --chmod=755 docker/web-entrypoint.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build --chown=nginx:nginx /app/web-dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz
